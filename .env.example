# Environment variables for Resume Genie
# Copy to `.env` and fill in values. Never commit `.env`.

# PostgreSQL connection string (Neon free tier recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Signs the anonymous per-browser session cookie (rg_sid). Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Free Google Gemini key from https://aistudio.google.com (Get API key)
OPENAI_API_KEY=

# Gemini OpenAI-compatible endpoint (default). For Groq use: https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Chat model id. Gemini free tier default:
AI_MODEL=gemini-3.6-flash
# Groq fallback example: llama-3.3-70b-versatile

# API listen port (Render sets PORT automatically in production)
PORT=8080

# Soft daily generation caps (protect free Gemini quota)
GENERATION_SESSION_DAILY_LIMIT=5
GENERATION_IP_DAILY_LIMIT=10

# Optional: path to built frontend (defaults to artifacts/resume-ai/dist/public)
# STATIC_DIR=

# Frontend (Vite) — only needed for local `pnpm --filter @workspace/resume-ai run dev`
# PORT=5173
# BASE_PATH=/
# API_PROXY_TARGET=http://localhost:8080

# Optional AdSense (leave unset for labeled placeholders)
# VITE_ADSENSE_CLIENT=
# VITE_ADSENSE_SLOT_DASHBOARD=
# VITE_ADSENSE_SLOT_APPLICATIONS=
